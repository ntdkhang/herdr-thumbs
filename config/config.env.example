# herdr-thumbs configuration.
#
# Copy this file to the plugin config directory as config.env:
#
#   cp config/config.env.example "$(herdr plugin config-dir ntdkhang.thumbs)/config.env"
#
# It is sourced by the plugin scripts, so it is shell syntax, and every value
# shown here is the default.

# --- picker appearance and behaviour (passed through to thumbs) -------------

# Hint alphabet: qwerty, qwerty-homerow, qwerty-left-hand, qwerty-right-hand,
# azerty*, qwertz*, dvorak*, colemak*, abcd, numeric, and so on.
# THUMBS_ALPHABET=qwerty

# Where the hint sits on its match: left or right.
# THUMBS_POSITION=left

# Start in multi-selection mode, where each hint toggles a match and Space
# finalises the set. Off by default; pressing Space during a normal pick turns
# it on for that pick, so you rarely need this.
# THUMBS_MULTI=0

# Give the shortest hints to the matches nearest the bottom of the pane.
# THUMBS_REVERSE=1

# Reuse one hint for repeated occurrences of the same text.
# THUMBS_UNIQUE=1

# Wrap hints in square brackets for contrast.
# THUMBS_CONTRAST=0

# Colours: black, red, green, yellow, blue, magenta, cyan, white, default, or
# #RRGGBB.
# THUMBS_FG_COLOR=green
# THUMBS_BG_COLOR=black
# THUMBS_HINT_FG_COLOR=yellow
# THUMBS_HINT_BG_COLOR=black
# THUMBS_SELECT_FG_COLOR=blue
# THUMBS_SELECT_BG_COLOR=black
# THUMBS_MULTI_FG_COLOR=yellow
# THUMBS_MULTI_BG_COLOR=black

# --- what gets captured -----------------------------------------------------

# Pane snapshot to hint over: visible, recent, recent-unwrapped, detection.
# THUMBS_SOURCE=visible

# Limit the capture to the last N lines. Empty means the whole snapshot.
# THUMBS_LINES=

# Line up the hints with the pane's position inside the tab. Set to off if the
# padding ever looks wrong in your layout.
# THUMBS_ALIGN=auto

# Load the extra patterns shipped in config/patterns.default.txt.
# THUMBS_DEFAULT_PATTERNS=1

# --- what happens with a pick ----------------------------------------------

# How to reach the clipboard: auto tries wl-copy, pbcopy, xclip or xsel when a
# display is available and falls back to OSC 52 through the outer terminal.
# Can also be osc52, none, or the name of any command that reads stdin.
# THUMBS_CLIPBOARD=auto

# What an uppercase hint does, overriding the action it was invoked from:
#   paste  copy it and type it into the pane it came from
#   open   run the open dispatch (browser, editor, git show)
#   copy   just copy it
#   swap   copy actions open, open actions copy
# THUMBS_UPCASE=paste

# Show a toast for each pick.
# THUMBS_NOTIFY=1

# Path to a thumbs binary, if you would rather not use the vendored build.
# THUMBS_BIN=

# --- the "open" action ------------------------------------------------------
#
# Each of these is a shell command with {} standing in for the match. Leave one
# empty to keep the built-in behaviour described in the README.

# URLs. Default: xdg-open (Linux) or open (macOS).
# THUMBS_OPEN_URL=

# File paths. Default: $EDITOR in a split next to the pane, at the matched line.
# Custom commands receive an absolute path with an optional :line suffix.
# THUMBS_TARGET_PANE identifies the source pane for Herdr-aware openers.
# THUMBS_OPEN_PATH=

# Editor for the default path action, if not $VISUAL/$EDITOR.
# THUMBS_EDITOR=

# Git SHAs. Default: git show in a split.
# THUMBS_OPEN_SHA=

# Everything else. "copy" falls back to copying the match.
# THUMBS_OPEN_OTHER=copy
